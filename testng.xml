<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Default suite: runs ALL Amazon tests on ONE browser.
  Default browser = chrome. Override from the command line:
      mvn clean test -Dbrowser=firefox
      mvn clean test -Dbrowser=edge
  (A -Dbrowser value always wins over the parameter below.)
-->
<suite name="Amazon Selenium Grid Suite" verbose="1">
    <parameter name="browser" value="chrome"/>

    <test name="Amazon Tests">
        <classes>
            <class name="tests.AmazonHomePageTest"/>
            <class name="tests.AmazonSearchTest"/>
        </classes>
    </test>
</suite>
